# Database
DATABASE_URL=postgresql://user:pass@host.neon.tech/devasign-eval

# AI Judge Providers — both required for full functionality
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# Default judge provider ("claude" or "gemini")
