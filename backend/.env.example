# DevAsign Agent API — source of agent reviews (manual-analysis endpoint)
DEVASIGN_AGENT_API_URL=https://2b53b2d3-6001.uks1.devtunnels.ms

# GitHub — PR metadata only (diff, changed files, author)
GITHUB_TOKEN=

# Auth — Bearer token for the eval app's own API
EVAL_API_KEY=local-dev-key

# Server
PORT=3001
APP_ENV=development
